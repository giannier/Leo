# Copy to `.env` and adjust for your machine. Never commit the real `.env`.
# Every value below is a safe local-development default -- no real secrets.

# --- Application (read by app.core.config.Settings) ---------------------
APP_NAME="Leo API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# SQLAlchemy 2.x URL (psycopg 3 driver). Matches the `postgres` service
# below when running via docker-compose.dev.yml; use `localhost` instead
# of `postgres` when running the backend directly on the host.
DATABASE_URL=postgresql+psycopg://leo:leo@localhost:5432/leo

REDIS_URL=redis://localhost:6379/0

# Auth (JWT access + refresh). CHANGE `SECRET_KEY` for any shared/deployed
# environment -- this default is for local development only.
SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3-compatible object storage (MinIO locally).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=leo-minio
S3_SECRET_KEY=leo-minio-secret
S3_BUCKET=leo-storage
S3_REGION=us-east-1

# JSON array of allowed origins (pydantic-settings parses list[str] from JSON).
CORS_ORIGINS=["http://localhost:3000"]

# --- Docker Compose infra (deploy/docker-compose.dev.yml substitution) --
# These configure the `postgres` and `minio` containers themselves, and the
# host ports each service is published on. Keep POSTGRES_* / S3_* pairs in
# sync with the values above when running everything through Compose.
POSTGRES_USER=leo
POSTGRES_PASSWORD=leo
POSTGRES_DB=leo
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8000
FRONTEND_PORT=3000
