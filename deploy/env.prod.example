# Production settings for deploy/docker-compose.prod.yml (TASK-026).
# Copy to deploy/.env.prod, fill every value, `chmod 600`. Never commit it.
# The full list of what the backend reads is deploy/env.reference.

# --- the site --------------------------------------------------------------
# Leo answers at https://<LEO_DOMAIN>; files at files.<LEO_DOMAIN>; the optional
# monitor at status.<LEO_DOMAIN>. The three names must point to the VPS (DNS A).
LEO_DOMAIN=app.ejemplo.pe
ACME_EMAIL=tu@correo.com

# --- secrets (generate, never reuse the development ones) -------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every stored WhatsApp credential unreadable: keep a copy offline.
CREDENTIALS_ENCRYPTION_KEY=

# --- database, cache, files --------------------------------------------------
POSTGRES_USER=leo
POSTGRES_PASSWORD=
POSTGRES_DB=leo
MINIO_ROOT_USER=leo-files
MINIO_ROOT_PASSWORD=
S3_BUCKET=leo-storage

# --- the model -------------------------------------------------------------
LLM_PROFILE=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- email (verification, receipts, notices) ---------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Leo <hola@ejemplo.pe>

# --- WhatsApp (YCloud) ---------------------------------------------------------
YCLOUD_WEBHOOK_SECRET=

# --- platform billing ------------------------------------------------------
# Off while Giannier tests with his own businesses. Turn it on only when Leo
# starts selling, and only with his confirmation (CLAUDE.md).
BILLING_ENFORCED=false
BILLING_PAYMENT_INSTRUCTIONS=

# --- backups (deploy/backup.sh) -----------------------------------------------
# Passphrase that encrypts every backup. Without it a backup cannot be restored:
# keep a copy outside the VPS.
BACKUP_PASSPHRASE=
BACKUP_DIR=/var/backups/leo
BACKUP_KEEP_DAYS=14
