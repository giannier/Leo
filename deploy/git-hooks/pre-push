#!/bin/sh
#
# Refuse to push to main unless lint, types and both test suites pass.
#
# This is a stand-in, not a replacement, for the server-side gate. GitHub
# charges for branch protection and rulesets on private repositories, so the
# `CI` check still runs and still reports - it just cannot block a merge.
#
# What this does cover is the failure that actually happens to a solo
# maintainer: pushing something broken by accident. It is bypassable with
# `--no-verify`, which is deliberate; a hook that cannot be bypassed in an
# emergency gets uninstalled, and then it protects nothing.
#
# Install with `make hooks`.

set -e

protected_branch="main"
remote_ref_prefix="refs/heads/"

# stdin is "<local ref> <local sha> <remote ref> <remote sha>" per ref.
pushing_to_protected=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        "${remote_ref_prefix}${protected_branch}")
            pushing_to_protected=1
            ;;
    esac
done

if [ "$pushing_to_protected" -eq 0 ]; then
    exit 0
fi

printf '\n[pre-push] Pushing to %s. Running the same gates as CI.\n\n' "$protected_branch"

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v make >/dev/null 2>&1; then
    printf '[pre-push] make is not on PATH; cannot verify. Refusing.\n'
    printf '[pre-push] Install make, or bypass deliberately with --no-verify.\n'
    exit 1
fi

fail() {
    printf '\n[pre-push] %s failed. Push refused.\n' "$1"
    printf '[pre-push] Fix it, or bypass deliberately with: git push --no-verify\n\n'
    exit 1
}

make lint      || fail "lint"
make test      || fail "tests"
make isolation || fail "multi-tenant isolation"

printf '\n[pre-push] All gates green. Pushing.\n\n'
exit 0
