# Reference environment for Leo - GENERATED from app/core/config.py.
#
# Regenerate with `make env-reference`. Copy what you need into `.env`, which
# is git-ignored and is the only place real credentials belong.
#
# Every variable below has a working development default except the ones
# marked REQUIRED. Omitting the rest is fine.


# --- General -----------------------------------------------------
APP_NAME=Leo API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database / Redis --------------------------------------------
DATABASE_URL=postgresql+psycopg://leo:leo@localhost:5432/leo
REDIS_URL=redis://localhost:6379/0

# --- Platform billing --------------------------------------------
BILLING_ENFORCED=false

# --- Auth --------------------------------------------------------
# REQUIRED - no usable default
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=900
TRUST_PROXY_HEADERS=false

# --- Credential encryption ---------------------------------------
# REQUIRED - no usable default
CREDENTIALS_ENCRYPTION_KEY=

# --- LLM providers -----------------------------------------------
LLM_PROFILE=openai
VISION_ENABLED=true
# REQUIRED - no usable default
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Transactional email -----------------------------------------
EMAIL_PROVIDER=auto
# REQUIRED - no usable default
RESEND_API_KEY=
EMAIL_FROM=Leo <onboarding@example.com>
EMAIL_OUTBOX_PATH=
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# --- Phone OTP ---------------------------------------------------
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=3600

# --- WhatsApp channel --------------------------------------------
# REQUIRED - no usable default
YCLOUD_WEBHOOK_SECRET=
YCLOUD_BASE_URL=https://api.ycloud.com/v2
CHANNEL_DEBOUNCE_SECONDS=8
CHANNEL_SEND_MAX_ATTEMPTS=3

# --- Object storage ----------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=leo-minio
S3_SECRET_KEY=leo-minio-secret
S3_BUCKET=leo-storage
S3_REGION=us-east-1

# --- Knowledge / RAG ---------------------------------------------
KNOWLEDGE_MAX_PDF_BYTES=10485760
KNOWLEDGE_CHUNK_CHARS=1000
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_EMBED_BATCH_SIZE=32
KNOWLEDGE_SEARCH_DEFAULT_K=5

# --- Frontend / CORS ---------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Ungrouped ------------------------------------------------
KNOWLEDGE_OCR_CONCURRENCY=3
KNOWLEDGE_OCR_MAX_PAGES=30
KNOWLEDGE_OCR_MAX_TOKENS=2500
KNOWLEDGE_OCR_MIN_CHARS=20
KNOWLEDGE_OCR_TIMEOUT_SECONDS=90.0
KNOWLEDGE_WEB_MAX_PAGE_BYTES=2000000
KNOWLEDGE_WEB_MAX_PAGES=20
KNOWLEDGE_WEB_TIMEOUT_SECONDS=10.0
LLM_CREDITS_ECONOMICO=1
LLM_CREDITS_MEDIO=1
LLM_CREDITS_MEJOR=1
LLM_MODEL_ECONOMICO=
LLM_MODEL_MEDIO=
LLM_MODEL_MEJOR=
SANDBOX_RATE_LIMIT_REQUESTS=30
SANDBOX_RATE_LIMIT_WINDOW_SECONDS=60
