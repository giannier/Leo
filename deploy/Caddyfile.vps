# Gateway interno para esta VPS: nginx-proxy-manager ya termina el HTTPS,
# así que aquí solo se reparte por ruta, sin certificados.
{
	auto_https off
}

:80 {
	encode zstd gzip

	@backend path /api/* /webhooks/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
